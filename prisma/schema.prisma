generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Job {
  id                    String   @id @default(uuid())
  jobId                 String   @unique  // LinkedIn 的职位ID (job_id)
  refId                 String?  // LinkedIn 的引用ID，用于构造详情URL
  title                 String   // 职位标题
  company               String   // 公司名称
  companyUrl            String?  // 公司主页 URL，用于归一化不同名称但同一实体的公司
  location              String?  // 地点
  description           String?  @db.Text  // 职位描述 (job_description)
  url                   String   @unique  // 职位链接 (link)
  salary                String?  // 薪资范围 (salary_range)
  salaryNumeric         Float?   // 转换后的年薪数值（美元）
  postedAt              DateTime?  // 发布日期 (posted_date_attr)
  postedText            String?  // 发布日期文本 (posted_text)
  applicantsCount       String?  // 申请人数 (applicants_count)
  
  // 职位标准信息 - 拆分为单独的字段，从job_criteria提取
  seniority             String?  // 职位级别
  employmentType        String?  // 雇佣类型
  jobFunction           String?  // 工作职能
  industries            String?  // 行业
  
  // 远程工作标志
  isRemote              Boolean  @default(true)  // 是否远程工作
  
  descriptionFallback   String?  @db.Text  // 备选描述 (job_description_fallback)
  
  // 系统字段
  createdAt             DateTime @default(now())  // 记录创建时间
  updatedAt             DateTime @updatedAt  // 记录更新时间
  searchCount           Int      @default(1)  // 搜索次数
  lastSearchedAt        DateTime @default(now())  // 最后被搜索的时间
}

// 任务进度模型
model TaskProgress {
  id            String   @id @default("current")
  geoIndex      Int      // 当前地理位置索引
  keywordIndex  Int      // 当前关键词索引
  step          Int      // 当前步骤
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 搜索配置模型
model SearchConfig {
  id          String   @id @default(cuid())
  userId      String               // 标识用户（可对接登录系统、邮箱、或 GitHub ID）
  configType  String               // 任意类型，如 'keywords'、'countries'、'xxxPrompt'
  configData  Json                 // 配置 JSON 内容
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, configType], name: "userId_configType")  // 每个用户每个类型只能有一条
}

// 汇率模型
model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  rates     Json     // 存储汇率数据的JSON对象
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model JobClean {
  id                  String   @id @default(uuid())          // 唯一主键
  jobId               String   @unique                      // 平台唯一岗位ID
  refId               String?                               // 平台跟踪Ref
  jobUrl              String                                // 岗位详情页url

  title               String                                // 原始岗位title
  titleClass          String?                               // 标准化类别
  companyName         String?                               // 公司名（标准化/原始）
  companyId           String?                               // 归一id, 由companyUrl生成
  companyUrl          String?                               // 公司主页url

  // 地理信息
  country             String?  @db.Char(2)                  // ISO2国家码
  region              String?                               // 省/州
  city                String?                               // 城市
  lat                 Float?                                // 纬度
  lng                 Float?                                // 经度

  // 薪资结构化
  salaryMin           Int?                                  // 最低薪资
  salaryMax           Int?                                  // 最高薪资
  salaryCurrency      SalaryCurrency?                       // 薪资货币（enum）
  salaryPeriod        SalaryPeriod?                         // 薪资周期（enum）
  salaryUsdYearMin    Float?                                // 美元年薪(最低)
  salaryUsdYearMax    Float?                                // 美元年薪(最高)

  postedAt            DateTime?                             // 发布时间
  applicantsCount     Int?                                  // 申请人数
  applicantsIsCapped  Boolean  @default(false)              // 申请人数上限

  platform            String   @default("linkedin")         // 来源平台          // 是否远程
  workplaceType       WorkplaceType @default(ON_SITE)       // 办公类型（enum）
  employmentType      EmploymentType                        // 雇佣类型（enum）
  seniority           Seniority?                            // 职位级别（enum）

  experienceCategory  ExperienceCategory?                   // 经验年限类别（NLP抽取/enum）
  jobFunction         String?                               // 职能
  industries          String?                               // 行业
  educationRequired   EducationLevel?                       // 学历要求（enum）
  mandatoryTech       String[]                              // 必须技术
  niceToHaveTech      String[]                              // 加分技术
  softSkills          String[]                              // 软技能
  certificatesRequired String[]                             // 证书要求
  benefits            String[]                              // 福利

  languages           String[]                              // 必须语言
  timezoneRestriction Int[]                                 // 时区限制（如[-5, 3]）

  description         String?   @db.Text                    // 原始JD

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ----------- 枚举建议 -----------

enum SalaryPeriod {
  YEAR
  MONTH
  WEEK
  DAY
  HOUR
}

enum WorkplaceType {
  REMOTE
  ON_SITE
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
  TEMPORARY
  INTERNSHIP
  VOLUNTEER
  OTHER
}

enum Seniority {
